{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Track Builder",
  "version": "1.0.0",
  "identifier": "io.github.autocross.coursedesigner",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "ApexSites.club Track Builder  \u00b7  Sign your club up at apexsites.club",
        "width": 1440,
        "height": 900,
        "resizable": true,
        "fullscreen": false,
        "label": "main",
        "minWidth": 1000,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "createUpdaterArtifacts": true,
    "publisher": "ApexSites.club",
    "shortDescription": "ApexSites.club Track Builder",
    "longDescription": "Free autocross course designer from ApexSites.club: map the site, design the course, check SCCA safety rules, run it in 3D and publish it to your club website.",
    "windows": {
      "nsis": {
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM4MUIyMjBDQ0EwQjdDMzkKUldRNWZBdktEQ0lieU1USmV2bGRUOStwYng1YTdDTklxOTZMaGJrbk55RlZZQ083MU9TVVNKNXQK",
      "endpoints": [
        "https://github.com/eac-wirings/autocross-course-designer/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
